# ---------------------------------------------------------------------------
# Knowledge Assistant - example environment configuration
# Copy to `.env` and adjust. NEVER commit a real `.env` with secrets.
# All variables are prefixed with KA_ and override configs/default.yaml.
# ---------------------------------------------------------------------------

# Runtime
KA_ENV=local
KA_LOG_LEVEL=INFO
KA_LOG_JSON=false

# --- LLM provider -----------------------------------------------------------
# Options: ollama | openai
KA_LLM_PROVIDER=ollama
KA_OLLAMA_BASE_URL=http://localhost:11434
KA_OLLAMA_MODEL=llama3.2:3b
KA_OLLAMA_TIMEOUT=120
KA_LLM_TEMPERATURE=0.1
KA_LLM_NUM_CTX=8192

# Only used when KA_LLM_PROVIDER=openai (leave blank otherwise). SECRET.
KA_OPENAI_API_KEY=
KA_OPENAI_BASE_URL=
KA_OPENAI_MODEL=gpt-4o-mini

# --- Embeddings -------------------------------------------------------------
# Options: sentence_transformers | openai
KA_EMBEDDING_PROVIDER=sentence_transformers
KA_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# auto -> cuda > mps > cpu (portable); or force cpu/cuda/mps
KA_EMBEDDING_DEVICE=auto
KA_OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Reranker ---------------------------------------------------------------
KA_RERANKER_ENABLED=true
KA_RERANKER_MODEL=BAAI/bge-reranker-base
KA_RERANK_TOP_N=5

# --- Vector store (Chroma server) ------------------------------------------
KA_CHROMA_HOST=localhost
KA_CHROMA_PORT=8000
KA_CHROMA_COLLECTION=knowledge_base

# --- Paths ------------------------------------------------------------------
KA_CORPUS_DIR=data/corpus
KA_DATA_DIR=data

# --- Chunking ---------------------------------------------------------------
KA_CHUNK_SIZE_TOKENS=600
KA_CHUNK_OVERLAP_TOKENS=90
KA_MIN_CHUNK_TOKENS=50

# --- Retrieval --------------------------------------------------------------
KA_RETRIEVAL_TOP_K=5
KA_DENSE_TOP_K=20
KA_BM25_TOP_K=20
KA_RRF_K=60
KA_HYBRID_ENABLED=true
KA_BM25_ENABLED=true

# --- Grounding / abstention -------------------------------------------------
KA_GROUNDING_ENABLED=true
KA_GROUNDING_MIN_SCORE=0.15

# --- Agent ------------------------------------------------------------------
KA_AGENT_ENABLED=true
KA_AGENT_MAX_STEPS=8
# auto | rag | agentic
KA_ROUTER_MODE=auto
# Rewrite the query once and retry when the first retrieval is too weak to ground.
KA_QUERY_REWRITE_ENABLED=true

# --- API --------------------------------------------------------------------
KA_API_HOST=0.0.0.0
KA_API_PORT=8080
KA_API_BASE_URL=http://localhost:8080
KA_CORS_ORIGINS=*
